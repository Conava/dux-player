[Desktop Entry]
Type=Application
Name=Dux Player
GenericName=Music Player
Comment=Play your music libraries and stream from your servers
Exec=dplayer open %U
Icon=com.marlonkranz.player
Terminal=false
Categories=AudioVideo;Audio;Player;Qt;
Keywords=music;audio;player;playlist;navidrome;subsonic;jellyfin;
StartupNotify=true
StartupWMClass=com.marlonkranz.player
MimeType=audio/flac;audio/x-flac;audio/mpeg;audio/mp3;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;audio/opus;audio/x-opus+ogg;audio/wav;audio/x-wav;audio/vnd.wave;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/x-aiff;audio/aiff;audio/x-ape;audio/x-wavpack;audio/x-musepack;audio/x-mpegurl;audio/mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;
Actions=play-pause;next;previous;

[Desktop Action play-pause]
Name=Play/Pause
Exec=dplayer toggle

[Desktop Action next]
Name=Next Track
Exec=dplayer next

[Desktop Action previous]
Name=Previous Track
Exec=dplayer previous
