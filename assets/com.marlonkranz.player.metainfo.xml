<component type="desktop-application">
  <id>com.marlonkranz.player</id>
  <launchable type="desktop-id">com.marlonkranz.player.desktop</launchable>
  <name>Dux Player</name>
  <summary>Music player for the Dux desktop</summary>

  <description>
    <p>Dux Player plays local music libraries and playlists and streams from Navidrome, Subsonic and Jellyfin servers. It is built with Quickshell, Qt 6, Go and mpv, and follows the look of Dux Shell.</p>
  </description>

