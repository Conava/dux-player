# Maintainer: Marlon Kranz <dev@marlonkranz.com>
pkgname=dux-player
pkgver=0.1.0
pkgrel=1
pkgdesc="Music player for local libraries and Navidrome, Subsonic and Jellyfin servers, in the style of Dux Shell"
arch=('x86_64' 'aarch64')
url="https://github.com/Conava/dux-player"
license=('MIT' 'LGPL-2.1-only')
depends=('mpv' 'quickshell' 'qt6-declarative' 'qt6-svg')
makedepends=('go')
optdepends=('ffmpeg: loudness measurement for even volume'
            'pipewire: playing to several outputs at once and the equalizer'
            'cast-helper: playing to Chromecast devices'
            'org.freedesktop.secrets: keeping server passwords in the keyring')
# the release's source tarball carries the dux-qml-common submodule and vendored Go modules
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export GOFLAGS="-buildmode=pie -trimpath -modcacherw"
  make build VERSION="$pkgver" COMMIT="v$pkgver"
}

check() {
  cd "$pkgname-$pkgver"
  make test-go
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
