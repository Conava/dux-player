pkgbase = dux-player-bin
	pkgdesc = Music player for local libraries and Navidrome, Subsonic and Jellyfin servers, in the style of Dux Shell (release binary)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/Conava/dux-player
	arch = x86_64
	arch = aarch64
	license = MIT
	license = LGPL-2.1-only
	depends = mpv
	depends = quickshell
	depends = qt6-declarative
	depends = qt6-svg
	optdepends = ffmpeg: loudness measurement for even volume
	optdepends = pipewire: playing to several outputs at once and the equalizer
	optdepends = cast-helper: playing to Chromecast devices
	optdepends = org.freedesktop.secrets: keeping server passwords in the keyring
	provides = dux-player
	conflicts = dux-player
	options = !strip
	options = !debug
	source_x86_64 = https://github.com/Conava/dux-player/releases/download/v0.1.0/dplayer-0.1.0-x86_64.tar.gz
	sha256sums_x86_64 = SKIP
	source_aarch64 = https://github.com/Conava/dux-player/releases/download/v0.1.0/dplayer-0.1.0-aarch64.tar.gz
